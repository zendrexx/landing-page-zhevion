# Contact forms (public by design; registered to a destination in Web3Forms)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Supabase Connect dialog → Project URL and publishable key.
# The publishable key is safe to expose and remains constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put a Supabase secret/service-role key in a NEXT_PUBLIC_ variable.
